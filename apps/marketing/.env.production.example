# Insight AI - Production Environment Template
# This file contains the required secrets for a live deployment.
# NEVER commit the actual values to version control.

# 1. Database & Persistence
DATABASE_URL="postgresql://user:password@db-host:5432/insight_ai?sslmode=require"
REDIS_URL="rediss://:password@redis-host:6379"

# 2. Authentication
JWT_SECRET="generate-a-long-random-string-here"
NEXTAUTH_SECRET="another-random-string-for-nextauth"

# 3. Stripe Billing (Production Mode)
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRO_PRICE_ID="price_..."
STRIPE_ENT_PRICE_ID="price_..."

# 4. Analytics & Growth
NEXT_PUBLIC_POSTHOG_KEY="phc_..."
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# 5. Service Orchestration
AI_SERVICE_URL="https://nlp.insight-ai.io"
NEXT_PUBLIC_API_URL="https://api.insight-ai.io"
FRONTEND_URL="https://app.insight-ai.io"

# 6. AI Engine Access (Production Keys)
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-..."
PERPLEXITY_API_KEY="pplx-..."

# 7. Monitoring & Logging
LOG_LEVEL="info"
NODE_ENV="production"
ENABLE_PROMETHEUS=true
